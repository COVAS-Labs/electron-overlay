{
  "name": "@covas-labs/electron-overlay",
  "version": "0.1.0",
  "description": "Native window policy controller for Electron overlays on Linux, Windows, and macOS.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "electron": ">=37"
  },
  "optionalDependencies": {
    "@covas-labs/electron-overlay-prebuilt-darwin-arm64": "0.1.0",
    "@covas-labs/electron-overlay-prebuilt-darwin-x64": "0.1.0",
    "@covas-labs/electron-overlay-prebuilt-linux-arm64": "0.1.0",
    "@covas-labs/electron-overlay-prebuilt-linux-x64": "0.1.0",
    "@covas-labs/electron-overlay-prebuilt-win32-arm64": "0.1.0",
    "@covas-labs/electron-overlay-prebuilt-win32-x64": "0.1.0"
  }
}
